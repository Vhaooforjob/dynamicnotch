# Shared runtime
APP_ENV=development

# Backend API (apps/api)
API_HOST=127.0.0.1
API_PORT=4000
# Render sets PORT automatically in production. Local dev can keep API_PORT.
# PORT=
JWT_SECRET=replace-me-in-development
LOG_LEVEL=info

# Backend database (PostgreSQL/Neon; server-side only)
DATABASE_URL=
DATABASE_URL_TEST=

# macOS frontend (apps/macos)
# The native app calls the API. It must never connect directly to PostgreSQL.
NOTCHFLOW_API_BASE_URL=http://127.0.0.1:4000/api/v1
NOTCHFLOW_CLOUD_SYNC_ENABLED=false
