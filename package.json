{
  "name": "dynamicnotch",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev:api": "pnpm --filter @dynamicnotch/api dev",
    "build": "pnpm --filter @dynamicnotch/contracts build && pnpm --filter @dynamicnotch/database build && pnpm --filter @dynamicnotch/api build",
    "test": "pnpm --filter @dynamicnotch/contracts build && pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @dynamicnotch/database db:generate",
    "db:migrate": "pnpm --filter @dynamicnotch/database db:migrate",
    "db:studio": "pnpm --filter @dynamicnotch/database db:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
